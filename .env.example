# ccms-operations-service (Transaction) — copy to .env.local (the local stack does this for you).
# Tables are created automatically from the TypeORM entities on start. Own database: ccms_operations, own credentials.
DATABASE_URL=postgres://ccms_operations:ccms_operations_dev_pw@127.0.0.1:5436/ccms_operations
DB_SYNCHRONIZE=true

# Token verification (Identity publishes the public keys)
IDENTITY_JWKS_URL=http://127.0.0.1:3001/api/auth/jwks
JWT_ISSUER=ccms-identity
JWT_AUDIENCE=ccms

# Service-to-service shared key and the Logs service (audit events)
SERVICE_KEY=change-me-dev-service-key
LOGS_SERVICE_URL=http://127.0.0.1:3002/api

# Core (Catalogue + Calendar): standards, offices and the working-time engine. With or without the trailing /api.
CORE_URL=http://127.0.0.1:3003/api

# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" to /api/jobs/*. Without it the jobs never run.
CRON_SECRET=change-me-dev-cron-secret

# Receipt email (CC024, stretch). Leave SMTP_HOST empty to send nothing: receipts then stay PENDING/FAILED and are retried by the job.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@pup.edu.ph

# Neon: use the pooled (-pooler) connection string and keep the per-instance pool small.
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/ccms_operations?sslmode=require
#   DB_POOL_MAX=3
